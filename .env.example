# ---- Server ----
PORT=4000
PREVIEW_PORT=4001
DASHBOARD_ORIGIN=http://localhost:5173

# ---- LLM provider (provider-agnostic; swap without touching the pipeline) ----
# Supported ids: anthropic | openai_compatible | mock
# "mock" needs no key and is used by the automated tests.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Only needed for openai_compatible (or a proxy)
LLM_BASE_URL=
# Smaller/cheaper model for requirements + planning, stronger model for code + repair
LLM_MODEL_PLANNER=claude-sonnet-5-5
LLM_MODEL_CODER=claude-sonnet-5-5
# Keep low and FIXED during experiments so conditions are comparable
# LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=120000
LLM_CODE_TIMEOUT_MS=300000

# ---- Pipeline ----
RUN_MODE=live
MAX_REPAIR_ATTEMPTS=3
BUILD_TIMEOUT_MS=120000
# WORKSPACE_DIR=   (defaults to ./workspace)
